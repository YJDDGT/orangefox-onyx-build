# Android fstab for onyx (Redmi Turbo 4 Pro)
# Recovery mount points

# System partitions (EROFS)
/dev/block/bootdevice/by-name/system           /system_root        erofs   ro                                                          wait,slotselect,first_stage_mount,logical
/dev/block/bootdevice/by-name/system_ext       /system_ext         erofs   ro                                                          wait,slotselect,first_stage_mount,logical
/dev/block/bootdevice/by-name/product          /product            erofs   ro                                                          wait,slotselect,first_stage_mount,logical
/dev/block/bootdevice/by-name/vendor           /vendor             erofs   ro                                                          wait,slotselect,first_stage_mount,logical
/dev/block/bootdevice/by-name/vendor_dlkm      /vendor_dlkm        erofs   ro                                                          wait,slotselect,first_stage_mount,logical
/dev/block/bootdevice/by-name/system_dlkm      /system_dlkm        erofs   ro                                                          wait,slotselect,first_stage_mount,logical
/dev/block/bootdevice/by-name/odm              /odm                erofs   ro                                                          wait,slotselect,first_stage_mount,logical
/dev/block/bootdevice/by-name/mi_ext           /mi_ext             erofs   ro                                                          wait,slotselect,first_stage_mount,logical

# Data (F2FS)
/dev/block/bootdevice/by-name/userdata         /data               f2fs    noatime,nosuid,nodev,discard,inlinecrypt                    wait,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,quota,reservedsize=128M,checkpoint=fs

# Metadata (F2FS)
/dev/block/bootdevice/by-name/metadata         /metadata           f2fs    noatime,nosuid,nodev,discard                               wait,formattable,first_stage_mount

# Cache (EXT4)
/dev/block/bootdevice/by-name/cache            /cache              ext4    noatime,nosuid,nodev,noexec                                 wait,formattable

# Persist (EXT4)
/dev/block/bootdevice/by-name/persist          /persist            ext4    noatime,nosuid,nodev                                       wait

# Firmware
/dev/block/bootdevice/by-name/modem            /firmware           vfat    ro,context=u:object_r:firmware_file:s0                    wait,slotselect
/dev/block/bootdevice/by-name/bluetooth        /bluetooth          vfat    ro,context=u:object_r:bt_firmware_file:s0                 wait,slotselect
/dev/block/bootdevice/by-name/dsp              /dsp                ext4    ro                                                          wait,slotselect

# External storage
/dev/block/bootdevice/by-name/userdata         /sdcard             f2fs    noatime,nosuid,nodev,discard,inlinecrypt                    wait,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,quota,reservedsize=128M,checkpoint=fs
/devices/platform/*.dwc3/*.dwc3/xhci-hcd.*.auto/usb*/host*    /usb_otg            auto    defaults                                                     voldmanaged=usb_otg:auto
